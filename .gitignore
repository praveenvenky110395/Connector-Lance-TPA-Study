# Solver output is not committed. The input decks are, and so are the CSVs and
# figures the extract and postprocess scripts write into results/. Everything
# below comes back by running a deck.
#
# This matters more than usual here: Stage 3 writes spcforc every 0.5 us, which
# is 30 MB per extraction run and about 90 MB for the insertion run.

# LS-DYNA binary and scratch
d3plot*
d3dump*
d3full*
d3thdt*
d3hsp
d3kil
messag
status.out
dyna.str
runrsf
adptmp
kill_by_pid
bg_switch
load_profile*
cont_profile*
lsrun.out.txt
mes0*
core.*
*.binout
binout*
scr/

# LS-DYNA ASCII output - read by the extract scripts, not committed
glstat
matsum
spcforc
rcforc
bndout
nodout
elout
secforc
sleout
abstat
deforc
jntforc
sbtout
ncforc

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*~
*.swp
